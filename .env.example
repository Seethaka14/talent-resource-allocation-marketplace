# ==============================================================================
# Talent & Resource Allocation Marketplace - Environment Configuration Template
# ==============================================================================
# Copy this file or set these variables in your environment before starting
# the application or executing the test suite.
#
# IMPORTANT: Spring Boot does NOT automatically load .env files without
# a dedicated library. To set these variables in Windows PowerShell:
#
#   $env:SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/talent_marketplace"
#   $env:SPRING_DATASOURCE_USERNAME="root"
#   $env:SPRING_DATASOURCE_PASSWORD="your_local_mysql_password_here"
#   $env:OLLAMA_BASE_URL="http://localhost:11434"
#   $env:OLLAMA_MODEL="llama3.2:3b"
#
# On macOS / Linux (bash or zsh):
#   export SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/talent_marketplace"
#   export SPRING_DATASOURCE_USERNAME="root"
#   export SPRING_DATASOURCE_PASSWORD="your_local_mysql_password_here"
#   export OLLAMA_BASE_URL="http://localhost:11434"
#   export OLLAMA_MODEL="llama3.2:3b"
# ==============================================================================

# Database Connection Settings
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/talent_marketplace
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_local_mysql_password_here

# Local AI Assistant (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: Demo Accounts Initializer Customization (leave blank to use defaults)
# APP_DEMO_PM_EMAIL=pm@talentmarketplace.com
# APP_DEMO_PM_PASSWORD=your_demo_pm_password
# APP_DEMO_RM_EMAIL=rm@talentmarketplace.com
# APP_DEMO_RM_PASSWORD=your_demo_rm_password
